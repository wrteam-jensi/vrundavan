rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog content — readable by anyone, writable only by signed-in admins.
    match /produce/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /crops/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /fruits/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin-only operational data — no public read.
    match /vaadis/{docId} {
      allow read, write: if request.auth != null;
    }

    match /paks/{docId} {
      allow read, write: if request.auth != null;
    }

    match /partnerWithdrawals/{docId} {
      allow read, write: if request.auth != null;
    }

    match /farmers/{docId} {
      allow read, write: if request.auth != null;
    }

    match /harvestEntries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /farmCrops/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
