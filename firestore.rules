rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog content — readable by anyone, writable only by signed-in admins.
    match /produce/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /crops/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /fruits/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin-only operational data — scoped to the owning admin.
    match /vaadis/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    match /paks/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    match /partnerWithdrawals/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    match /farmers/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    match /harvestEntries/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    match /farmCrops/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
